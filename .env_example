# Chovique Backend Production Environment Variables Example
# DO NOT PUT REAL SECRETS IN THIS FILE

APP_NAME=CHOVIQUE
APP_VERSION=1.0.0
DEBUG=False
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chovique_db
DB_ECHO=False
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=your_production_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=["https://chovique.vercel.app","http://localhost:5173"]

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=
MAIL_FROM=your_email@example.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

OTP_EXPIRE_SECONDS=300
MAX_OTP_ATTEMPTS=5
MAX_OTP_RESEND_ATTEMPTS=3
OTP_RESEND_LOCKOUT_SECONDS=600

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret


# =====================================================
# Railway S3-Compatible Bucket (Tigris)
# =====================================================
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET_NAME=your_bucket_name_here
S3_ACCESS_KEY_ID=your_access_key_id_here
S3_SECRET_ACCESS_KEY=your_secret_access_key_here
S3_PUBLIC_BASE_URL=https://your_bucket_name_here.t3.storageapi.dev

SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# =====================================================
# Google Gemini AI (Chatbot)
# =====================================================
# Required for the Chovique AI assistant (Coco)
# Get your free key from: https://aistudio.google.com/app/apikey
# Set this on Render: Environment → GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
