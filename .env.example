# Chovique Backend Production Environment Variables Example
# DO NOT PUT REAL SECRETS IN THIS FILE

APP_NAME=CHOVIQUE
APP_VERSION=1.0.0
DEBUG=False
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chovique_db
DB_ECHO=False
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=your_production_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=["https://chovique.vercel.app","http://localhost:5173"]

MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=
MAIL_FROM=your_email@example.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

OTP_EXPIRE_SECONDS=300
MAX_OTP_ATTEMPTS=3
MAX_OTP_RESEND_ATTEMPTS=3
OTP_RESEND_LOCKOUT_SECONDS=600

# =====================================================
# MSG91 OTP Integration
# =====================================================
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_OTP_TEMPLATE_ID=your_msg91_template_id_here
MSG91_SENDER_ID=CHOVIQ
MSG91_OTP_EXPIRY_MINUTES=5
MSG91_OTP_LENGTH=6
MSG91_API_URL=https://control.msg91.com/api/v5/otp

RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# =====================================================
# Meta WhatsApp Cloud API Webhook
# =====================================================
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
META_APP_SECRET=your_meta_app_secret_here

# =====================================================
# Railway S3-Compatible Bucket (Tigris)
# =====================================================
S3_ENDPOINT_URL=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET_NAME=your_bucket_name_here
S3_ACCESS_KEY_ID=your_access_key_id_here
S3_SECRET_ACCESS_KEY=your_secret_access_key_here
S3_PUBLIC_BASE_URL=https://your_bucket_name_here.t3.storageapi.dev

SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password
SUPERADMIN_PHONE=919876543210

# =====================================================
# Google Gemini AI (Chatbot)
# =====================================================
GEMINI_API_KEY=your_gemini_api_key_here
